{
  "buildCommand": "python3 -m venv .venv && .venv/bin/python -m pip install -q -r requirements.txt && .venv/bin/python build.py",
  "installCommand": "",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.westendorptoegang.nl"
        }
      ],
      "destination": "https://westendorptoegang.nl/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "westendorptoegangscontrole.nl"
        }
      ],
      "destination": "https://westendorptoegang.nl/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.westendorptoegangscontrole.nl"
        }
      ],
      "destination": "https://westendorptoegang.nl/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "toegangscontroles.nl"
        }
      ],
      "destination": "https://westendorptoegang.nl/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.toegangscontroles.nl"
        }
      ],
      "destination": "https://westendorptoegang.nl/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "westendorptoegangscontroles.nl"
        }
      ],
      "destination": "https://westendorptoegang.nl/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.westendorptoegangscontroles.nl"
        }
      ],
      "destination": "https://westendorptoegang.nl/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://bat.bing.com; connect-src 'self' https://api.web3forms.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://bat.bing.com; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com https://bat.bing.com; style-src 'self' 'unsafe-inline'; font-src 'self'; form-action 'self' https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
